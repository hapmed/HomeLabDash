# HomeLabDash — variables de entorno (valores FICTICIOS de ejemplo).
# Copia a `.env` en la raíz del proyecto. `.env` está en .gitignore.

# --- Aplicación ---
APP_NAME=HomeLabDash
ENVIRONMENT=local
DEBUG=false

# --- Base de datos (instancia PostgreSQL existente) ---
DATABASE_URL=postgresql+psycopg://homelabdash_app:change-me@postgres:5432/homelabdash

# --- Autenticación ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
JWT_TTL_MINUTES=720
COOKIE_NAME=hld_session
# true en producción con HTTPS (Cloudflare); false solo en local por HTTP.
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Administrador inicial (solo bootstrap; se guarda con hash) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Agente de métricas (solo red interna) ---
AGENT_URL=http://agent:8001
# Genera uno con: openssl rand -hex 32. Debe coincidir con el del agente.
AGENT_TOKEN=change-me-agent-token
AGENT_TIMEOUT_SECONDS=3

# --- Umbrales de estado ---
CPU_WARN=75
CPU_CRITICAL=90
MEMORY_WARN=80
MEMORY_CRITICAL=92
DISK_WARN=85
DISK_CRITICAL=95
LOAD_PER_CORE_WARN=1.0
LOAD_PER_CORE_CRITICAL=2.0

# --- Frontend (solo lo usa el servidor SvelteKit) ---
BACKEND_URL=http://api:8000
# Detrás de proxy: SvelteKit deduce el origen de estos encabezados.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
PORT=3000

# --- Monitor de Internet (módulo `internet`) ---
INTERNET_MONITOR_ENABLED=true
INTERNET_SPEEDTEST_MINUTES=60
INTERNET_CHECK_SECONDS=60
INTERNET_DOWNLOAD_BYTES=10000000
INTERNET_UPLOAD_BYTES=2000000
INTERNET_HISTORY_SIZE=168
INTERNET_LATENCY_WARN_MS=150
INTERNET_LATENCY_CRITICAL_MS=400

# --- Inventario de dispositivos de la red ---
NETWORK_MONITOR_ENABLED=true
NETWORK_CIDR=192.168.0.0/24
NETWORK_SCAN_SECONDS=60
# SSID visible; si está vacío se muestra "Red local <CIDR>".
NETWORK_NAME=

# --- Router Mercusys AC12 (opcional; solo lectura) ---
ROUTER_ENABLED=false
ROUTER_URL=http://192.168.0.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=
ROUTER_INFO_REFRESH_SECONDS=300
ROUTER_RETRY_SECONDS=300

# --- Ciclo mensual (corte el día indicado) ---
BILLING_CYCLE_DAY=10
BILLING_TIMEZONE=America/Monterrey
BILLING_HISTORY_MONTHS=24
BILLING_DAILY_HISTORY_DAYS=62

# --- Docker (socket solo lectura) ---
DOCKER_MONITOR_ENABLED=true
DOCKER_GID=989
DOCKER_POLL_SECONDS=30

# --- Clima (Open-Meteo, sin API key) ---
WEATHER_ENABLED=true
WEATHER_LATITUDE=25.6866
WEATHER_LONGITUDE=-100.3161
WEATHER_TIMEZONE=America/Monterrey
WEATHER_LOCATION=Monterrey
WEATHER_POLL_SECONDS=900
WEATHER_HISTORY_DAYS=730

# --- Monitor de base de datos ---
DATABASE_MONITOR_ENABLED=true
DATABASE_SNAPSHOT_SECONDS=300
DATABASE_HISTORY_DAYS=30

# --- OpenCode (contenedor dedicado) ---
OPENCODE_ENABLED=true
OPENCODE_CONTAINER=opencode
