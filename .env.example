# HomeLabDash — variables de entorno (valores FICTICIOS de ejemplo).
# Copia a `.env` en la raíz del proyecto. `.env` está en .gitignore.

# --- Aplicación ---
APP_NAME=HomeLabDash
ENVIRONMENT=local
DEBUG=false

# --- Base de datos (instancia PostgreSQL existente) ---
DATABASE_URL=postgresql+psycopg://homelabdash_app:change-me@postgres:5432/homelabdash

# --- Autenticación ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
JWT_TTL_MINUTES=720
COOKIE_NAME=hld_session
# true en producción con HTTPS (Cloudflare); false solo en local por HTTP.
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Administrador inicial (solo bootstrap; se guarda con hash) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Agente de métricas (solo red interna) ---
AGENT_URL=http://agent:8001
# Genera uno con: openssl rand -hex 32. Debe coincidir con el del agente.
AGENT_TOKEN=change-me-agent-token
AGENT_TIMEOUT_SECONDS=3

# --- Umbrales de estado ---
CPU_WARN=75
CPU_CRITICAL=90
MEMORY_WARN=80
MEMORY_CRITICAL=92
DISK_WARN=85
DISK_CRITICAL=95
LOAD_PER_CORE_WARN=1.0
LOAD_PER_CORE_CRITICAL=2.0

# --- Frontend (solo lo usa el servidor SvelteKit) ---
BACKEND_URL=http://api:8000
# Detrás de proxy: SvelteKit deduce el origen de estos encabezados.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
PORT=3000
